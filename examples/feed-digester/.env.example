# Feed Digester — copy to .env and fill in real values. NEVER commit .env.
# See docs/credentials.md for where each value comes from.

# Newsletter inbox (IMAP)
IMAP_HOST=imap.your-provider.com
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password-here

# Telegram (digest delivery + Editor alerts)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# GitHub (repo clone + PR workflow)
GITHUB_TOKEN=your-fine-grained-pat-here
GITHUB_REPO_URL=your-org/feed-digester

# Optional runtime knobs (defaults shown)
# DIGEST_RUN_ONCE=1
# CYCLE_TIMEOUT=1800
# MAX_CRASHES=5

# Do NOT set ANTHROPIC_API_KEY — this factory uses an OAuth session (Claude Max).
